# Must match EXECUTION_QUEUE_URL in the main API's .env — this worker and the
# API talk to each other only through this queue, never directly.
EXECUTION_QUEUE_URL=redis://localhost:6379
EXECUTION_QUEUE_NAME=codrive:execution-jobs
RESULT_STORE_PREFIX=codrive:execution-result:

# How many jobs this worker instance runs concurrently. Keep this modest —
# each job is a full container, and containers aren't free.
MAX_CONCURRENT_JOBS=4
