# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codrive

# Auth — generate long random strings for both secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Execution worker (see execution.service.ts) — this API only enqueues jobs,
# it never runs user code itself. Point this at wherever that queue lives.
EXECUTION_QUEUE_URL=redis://localhost:6379
